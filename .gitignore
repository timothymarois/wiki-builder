# ============================================================================
# wiki-builder
# ============================================================================

# --- Python bytecode and packaging output -----------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.whl

# --- Environments -----------------------------------------------------------
.venv/
venv/
env/
.python-version

# --- uv ---------------------------------------------------------------------
# The lock is not committed: the one dependency is pinned exactly in
# pyproject.toml, and consumers install with `uvx --from git+...`, which
# resolves from that and never reads a lock file.
uv.lock

# --- Test and type-checker caches -------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# --- A wiki built inside this repository ------------------------------------
# The rendered site is generated output wherever it appears. `wiki build`
# remakes it from the pages in seconds, and committing it means every page
# conflicts the moment the stylesheet moves.
docs/wiki/site/
**/docs/wiki/site/

# --- Editors and operating systems ------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# --- Scratch ----------------------------------------------------------------
tmp/
